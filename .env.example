# Application
ENVIRONMENT=local
APP_MODE=local

# Gemini API (used for chat and embeddings)
GOOGLE_API_KEY=google_api_key
VERTEX_LLM_MODEL_NAME=gemini-3.8-flash
LLM_TEMPERATURE=0.0

# Embeddings
LOCAL_EMBEDDING_MODEL_NAME=gemini-embedding-001
# Embedding dimensions are configured in Python (768)

# Local storage
LOCAL_DATA_DIR=.meridian
CHROMA_COLLECTION=meridian_docs
# Meridian AI - Application Settings

# Agent middleware guard-rails (optional, these are the defaults)
# AGENT_MAX_MODEL_CALLS=8
# AGENT_MAX_TOOL_CALLS=6
# AGENT_MAX_RETRIES=2

# Cloud Storage configuration
GCS_BUCKET_NAME=your-gcp-project-id-vector-staging
GCS_PREFIX=uploads/
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# Cloud storage - IDs printed at the end of the "Provision Vector Search" step in GitHub Actions
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_INDEX_ENDPOINT_ID=
# Path to the service-account key used for Vertex AI + Cloud Storage when running cloud mode from a laptop
GCP_SERVICE_ACCOUNT_PATH=./credentials/service-account.json
